# NPM Configuration for Windows Compatibility

# Better SQLite3 - use pre-built binaries when possible
better_sqlite3_binary_host=https://github.com/WiseLibs/better-sqlite3/releases/download

# Build from source if pre-built not available
build-from-source=true

# Increase network timeout for Windows
fetch-timeout=300000
fetch-retries=5

# Verbose logging for troubleshooting
loglevel=warn

